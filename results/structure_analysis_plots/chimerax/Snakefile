import os

configfile: "config.yaml"

STRUCTURES = config["structures"]
INPUT_FILES = config["input_files"]
SITE_MAP = config["site_map"]
OUTPUT_DIR = config["output_dir"]

# Map the wildcard {name} to:
# - effect column in the CSV
# - input file from config
EFFECT_COLS = {
    "cell_entry": "cell entry",
    "receptor_binding": "receptor binding",
    "escape_resistant": "human resistant sera escape",
    "escape_sensitive": "human sensitive sera escape",
    "escape_sera": "all sera escape",
}

FUNC_FILES = {
    "cell_entry": INPUT_FILES["cell entry"],
    "receptor_binding": INPUT_FILES["receptor binding"],
    "escape_resistant": INPUT_FILES["escape"]["human resistant sera escape"],
    "escape_sensitive": INPUT_FILES["escape"]["human sensitive sera escape"],
    "escape_sera": INPUT_FILES["escape"]["all sera escape"],
}

NAMES = list(EFFECT_COLS.keys())


def get_func_file(wildcards):
    return FUNC_FILES[wildcards.name]


rule all:
    input:
        expand(
            "results/{structure}/{name}_chimerax_{structure}.defattr",
            structure=STRUCTURES,
            name=NAMES,
        )


rule chimerax_filter:
    input:
        data="chimerax_pipeline.py",
        func_file=get_func_file,
        site_map=SITE_MAP,
    output:
        mean_file=os.path.join(
            OUTPUT_DIR,
            "{name}_chimerax_{structure}.csv",
        ),
    params:
        effect_col=lambda wc: EFFECT_COLS[wc.name],
        structure=lambda wc: wc.structure,
    shell:
        r"""
        python {input.data} \
            --func_file {input.func_file} \
            --site_map {input.site_map} \
            --structure {params.structure} \
            --effect_col "{params.effect_col}" \
            --outdir {OUTPUT_DIR}
        """

rule make_defattr:
    input:
        infile=rules.chimerax_filter.output.mean_file
    output:
        defattr="results/{structure}/{name}_chimerax_{structure}.defattr",
    params:
        name=lambda wc: wc.name,
        structure=lambda wc: wc.structure,
        effect_col=lambda wc: EFFECT_COLS[wc.name],
        outdir=lambda wc: f"results/{wc.structure}",
    shell:
        r"""
        python chimerax_pipeline.py \
            --aggregate \
            --infile {input.infile} \
            --name {params.name} \
            --effect_col_agg "{params.effect_col}" \
            --outdir {OUTPUT_DIR} \
            --outdir_agg {params.outdir}
        """
